{
  "name": "journey-vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:export-fonts && pnpm build:export-viewer && next dev",
    "build": "next build && pnpm build:export-viewer && pnpm build:export-manifest",
    "build:export-viewer": "vite build --config vite.export.config.ts && npx tsx scripts/copy-maplibre-worker.ts",
    "build:export-manifest": "npx tsx scripts/generate-map-manifest.ts",
    "build:export-fonts": "npx tsx scripts/generate-export-fonts.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@protomaps/basemaps": "^5.7.1",
    "@react-pdf/renderer": "^4.3.2",
    "@vis.gl/react-maplibre": "^8.1.0",
    "better-justified-layout": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.2",
    "flag-icons": "^7.5.0",
    "framer-motion": "^12.34.3",
    "idb": "^8.0.3",
    "lucide-react": "^0.575.0",
    "maplibre-gl": "^5.19.0",
    "next": "16.1.6",
    "pmtiles": "^4.4.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.0.1",
    "vitest": "^4.0.18"
  }
}
